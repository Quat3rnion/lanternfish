+int32_t llama_lanternfish_residual_gradient(
+        llama_context * ctx, const llama_token * tokens, int32_t count, int32_t first_label,
+        const float * labels, int32_t layer, int32_t position, const float * delta, float * loss,
+        float * grad, size_t width) {
+    try {
+        if (!ctx || !delta) {
+            return -1;
+        }
+        ctx->lanternfish_gradient(tokens, count, -1, layer, loss, grad, width, first_label, labels, position, delta);
+        return 0;
+    } catch (const std::exception & e) {
+        LLAMA_LOG_ERROR("%s: %s\n", __func__, e.what());
+        return -1;
+    }
+}
+
+ggml_tensor * llama_lanternfish_ffn_down(llama_model * model, int32_t layer) {
+    if (!model || layer < 0 || size_t(layer) >= model->layers.size()) {
+        return nullptr;
+    }
+    return model->layers[layer].ffn_down;
+}
