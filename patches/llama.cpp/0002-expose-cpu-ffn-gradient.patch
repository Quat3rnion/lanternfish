+            (model.arch != LLM_ARCH_LLAMA && model.arch != LLM_ARCH_QWEN2) ||
+            model.hparams.n_expert != 0 || model.hparams.swa_type != LLAMA_SWA_TYPE_NONE) {
+        throw std::runtime_error("unsupported gradient context, model, or target");
+    }
+    for (const auto & entry : model.tensors_by_name) {
+        if (entry.second->type != GGML_TYPE_F32) {
+            throw std::runtime_error("gradient requires F32 model weights");
+        }
+    }
+    auto * weight = model.layers[layer].ffn_down;
+    if (!weight || size_t(ggml_nelements(weight)) != grad_count) {
+        throw std::runtime_error("wrong FFN down weight size");
+    }
+    for (int32_t i = 0; i < count; ++i) {
+        if (tokens[i] < 0 || tokens[i] >= n_vocab) {
+            throw std::runtime_error("invalid input token");
+        }
+    }
+
+    // Build the ordinary model graph, with the existing training path that
+    // reads K/V directly rather than through the non-differentiable KV cache.
+    std::vector<int8_t> logits(count, 0);
+    logits.back() = 1;
+    auto batch = llama_batch_get_one(const_cast<llama_token *>(tokens), count);
+    batch.logits = logits.data();
+    llama_batch_compat compat(this, batch);
+    if (!balloc->init(*compat.batch_ext, model.vocab, false)) {
+        throw std::runtime_error("failed to initialize gradient batch");
+    }
+    auto mctx = memory->init_batch(*balloc, cparams.n_ubatch, false);
+    if (!mctx || mctx->get_status() != LLAMA_MEMORY_STATUS_SUCCESS || !mctx->apply() ||
+            mctx->get_ubatch().n_tokens != uint32_t(count)) {
+        throw std::runtime_error("gradient needs a single fresh ubatch");
+    }
+    const auto & ubatch = mctx->get_ubatch();
+    cparams.training = true;
+    n_outputs = 1;
+    const size_t capacity = graph_max_nodes(count);
+    sched_new(capacity, false);
+    llm_graph_result res(capacity);
+    auto * forward = model.build_graph(graph_params(&res, ubatch, mctx.get(), ctx_type_to_graph_type(cparams.ctx_type)));
+    auto * output = res.get_logits();
+    if (!forward || !output || output->ne[0] != n_vocab || output->ne[1] != 1) {
+        throw std::runtime_error("missing next-token logits");
+    }
+
+    ggml_context_ptr meta(ggml_init({
+        capacity * ggml_tensor_overhead() + ggml_graph_overhead_custom(capacity, true), nullptr, true,
+    }));
+    if (!meta) {
+        throw std::runtime_error("could not allocate gradient graph metadata");
+    }
+    auto * labels = ggml_new_tensor_1d(meta.get(), GGML_TYPE_F32, n_vocab);
+    ggml_set_input(labels);
+    auto * loss = ggml_cross_entropy_loss(meta.get(), output, labels);
+    ggml_set_loss(loss);
+    ggml_set_output(loss);
+    auto * graph = ggml_new_graph_custom(meta.get(), capacity, true);
+
+    // The scheduler records graph pointers. Drop it before the graph metadata,
+    // on success or error; this context is single-use.
+    struct reset_scheduler {
+        llama_context & ctx;
+        ~reset_scheduler() { ctx.sched.reset(); }
+    } reset { *this };
+
+    const auto flags = weight->flags;
+    ggml_set_param(weight);
+    ggml_build_forward_expand(graph, loss);
+    ggml_build_backward_expand(meta.get(), graph, nullptr);
+    weight->flags = flags;
+    auto * grad = ggml_graph_get_grad(graph, weight);
+    if (!grad || grad->type != GGML_TYPE_F32 || !ggml_is_contiguous(grad) ||
+            ggml_nbytes(grad) != grad_count * sizeof(float)) {
+        throw std::runtime_error("missing FFN down gradient");
+    }
+    ggml_set_output(grad);
+    if (!ggml_backend_sched_alloc_graph(sched.get(), graph)) {
