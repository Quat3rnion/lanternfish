+    one_hot[target] = 1.0f;
+    ggml_backend_tensor_set(labels, one_hot.data(), 0, n_vocab * sizeof(float));
+    ggml_graph_reset(graph);
+    if (graph_compute(graph, count > 1) != GGML_STATUS_SUCCESS) {
