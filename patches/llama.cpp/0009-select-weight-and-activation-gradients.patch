+ggml_tensor * llm_graph_context::displace(ggml_tensor * cur, int il, int role) const {
+    if (il != cparams.lanternfish_layer || role != cparams.lanternfish_role) {
+        return cur;
+    }
+    auto * delta = ggml_repeat(ctx0, cparams.lanternfish_delta, cur);
+    return ggml_add(ctx0, cur, ggml_mul(ctx0, delta, cparams.lanternfish_mask));
+}
